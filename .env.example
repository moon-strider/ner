# Pick one: cerebras, openai, anthropic, openrouter, vllm
NER_PROVIDER=cerebras
NER_MODEL=llama3.1-8b

# API keys — fill the one matching your provider
CEREBRAS_API_KEY=your-cerebras-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
VLLM_API_KEY=not-needed

# Optional base URL overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VLLM_BASE_URL=http://localhost:8000/v1

REQUEST_TIMEOUT_S=30
TRANSPORT_RETRIES=2
MAX_TOKENS=1024
OTEL_ENDPOINT=
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
PROVIDER_CONCURRENCY_LIMIT=50
MAX_TEXT_LENGTH=32000
MAX_LABELS=50
MAX_SYSTEM_PROMPT_LENGTH=20000
MAX_LABEL_DESCRIPTION_LENGTH=500
MAX_CONFIG_ID_LENGTH=128
