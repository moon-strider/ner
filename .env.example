# Local CPU quick start: run llama-server separately on port 8080.
NER_PROVIDER=llama_cpp
NER_MODEL=smollm2-1.7b
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_API_KEY=not-needed
REQUEST_TIMEOUT_S=90
PROVIDER_CONCURRENCY_LIMIT=1
BATCH_CONCURRENCY=1
MAX_TOKENS=256
CONFIG_DB_PATH=configs.db

# Optional service authentication. Uncomment and choose a long random value.
# NER_API_KEY=replace-with-a-random-secret

# For cloud use, change NER_PROVIDER and NER_MODEL above and set the matching key.
# CEREBRAS_API_KEY=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# VLLM_BASE_URL=http://127.0.0.1:8080/v1
# VLLM_API_KEY=not-needed

# Optional observability.
# OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# GRAFANA_ADMIN_PASSWORD=replace-with-a-random-secret
